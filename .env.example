# Flask Configuration
SECRET_KEY=your-secret-key-change-in-production
FLASK_DEBUG=False

# Server
HOST=0.0.0.0
PORT=5000

# CORS - comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-app.onrender.com

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:latest
OLLAMA_TIMEOUT=60
OLLAMA_NUM_PREDICT=512
OLLAMA_TEMPERATURE=0.1
OLLAMA_TOP_P=0.9

# Text Processing
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Chat Configuration
MAX_HISTORY_LENGTH=10
RAG_N_RESULTS=5
